# Plantilla de variables de entorno. Copiala a ".env" (local) y completá los valores.
# Este archivo SÍ se versiona: no pongas valores reales acá.

# Base de datos
DB_URL=jdbc:postgresql://localhost:5432/barberia
DB_USER=
DB_PASSWORD=

# Seguridad
APP_JWT_SECRET=
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=
SUPERADMIN2_USERNAME=
SUPERADMIN2_PASSWORD=

# Pagos (sandbox en local; los valores live van en Railway)
MP_BASE_URL=https://api.mercadopago.com
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=


PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
APP_PUBLIC_URL=http://localhost:4200
APP_BACKEND_URL=http://localhost:8080
MP_ENABLED=true
PAYPAL_ENABLED=true

